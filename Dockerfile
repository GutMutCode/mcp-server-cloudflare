# Generated by https://smithery.ai. See: https://smithery.ai/docs/config#dockerfile
FROM node:lts-alpine

# Install dependencies needed for building
RUN apk add --no-cache git

# Install pnpm globally
RUN npm install -g pnpm

WORKDIR /app

# Copy all files
COPY . .

# Install dependencies using pnpm (ignore scripts to avoid potential issues with prepare)
RUN pnpm install --frozen-lockfile --ignore-scripts

# Build the project
RUN pnpm run build

# Create a dummy Wrangler config file to satisfy the server expectations
RUN mkdir -p /root/.config/.wrangler/config \
    && echo "[default]" > /root/.config/.wrangler/config/default.toml \
    && echo "api_key = \"dummy\"" >> /root/.config/.wrangler/config/default.toml

# Default command to run the MCP server with a dummy account id
CMD ["node", "dist/index.js", "run", "dummy-account-id"]
